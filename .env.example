# switches: 1 = use the fake version (default while building)
STUB_EDGE=1
STUB_STEPFUN=1
STUB_ELEVENLABS=1
STUB_PHOTON=1

STEPFUN_API_KEY=
STEPFUN_BASE_URL=https://api.stepfun.com/v1    # or https://api.stepfun.ai/v1; match your key
STEPFUN_MODEL=step-5-preview
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
PHOTON_SERVER_ADDRESS=https://api.photon.codes/v1   # Photon Beta (2.0) API host
PHOTON_TOKEN=                                        # project API key, pho_sk_...
PHOTON_PROJECT_ID=                                   # pho_prj_...
PHOTON_AGENT_HANDLE=                                 # assigned iMessage line, E.164
COMMS_GATEWAY_PORT=8787                              # comms-gateway listen port
COMMS_GATEWAY_URL=http://localhost:8787              # backend -> gateway (comms.py)
BACKEND_URL=http://localhost:8000                    # gateway -> backend /comms/inbound
SENTRY_DSN=
SHARED_SECRET=change-me-before-demo           # Pi and backend sign with this
CAREGIVER_NUMBERS=+13105550101                # comma separated allowlist (fictional demo number)
NFC_ALLOWED_UIDS=                             # comma separated tag UIDs
INCIDENT_WINDOW_SECONDS=600
UNLOCK_HOLD_SECONDS=30
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173   # where dashboard/ is served; add http://<laptop-ip>:5173 for a phone
