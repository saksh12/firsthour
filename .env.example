# switches: 1 = use the fake version (default while building)
STUB_EDGE=1
STUB_STEPFUN=1
STUB_ELEVENLABS=1
STUB_PHOTON=1

STEPFUN_API_KEY=
STEPFUN_BASE_URL=https://api.stepfun.com/v1    # or https://api.stepfun.ai/v1; match your key
STEPFUN_MODEL=step-5-preview
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_turbo_v2_5                       # low-latency TTS model id
# VOICE_PLAYBACK=0                                       # uncomment to silence all audio (CI/tests)
# ELEVENLABS_BASE_URL=                                   # only to point at a mock/proxy
PHOTON_TOKEN=                                        # project API key, pho_sk_...
PHOTON_PROJECT_ID=                                   # pho_prj_...
PHOTON_AGENT_HANDLE=                                 # assigned iMessage line, E.164
COMMS_GATEWAY_PORT=8787                              # comms-gateway listen port
COMMS_GATEWAY_URL=http://localhost:8787              # backend -> gateway /send (STUB_PHOTON=0)
BACKEND_URL=http://localhost:8000                    # gateway and Pi -> backend; on the Pi use the laptop's LAN IP
SENTRY_DSN=
SHARED_SECRET=change-me-before-demo           # Pi and backend sign with this
CAREGIVER_NUMBERS=+13105550101                # comma separated allowlist (fictional demo number)
INCIDENT_WINDOW_SECONDS=600
UNLOCK_HOLD_SECONDS=30
# PI_STT=1: the dashboard records the answer and the Pi transcribes it with whisper.cpp (IMPLEMENTATION.md 6.8)
PI_STT=0
PI_STT_HOLD_SECONDS=20                              # silence timer waits this long for the Pi's transcript
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173   # where dashboard/ is served; add http://<laptop-ip>:5173 to watch from a phone (its buttons stay laptop-only)
DEVICE_ID=bath-01                                    # edge: also the local incident id prefix
SERIAL_PORT=                                         # edge: Arduino port, e.g. /dev/ttyACM0 (TODO(verify) on QNX)
SERIAL_BAUD=115200
# edge fusion thresholds: PLACEHOLDERS until calibration (IMPLEMENTATION.md 10.2)
SOUND_THRESHOLD=400
ACCEL_THRESHOLD_G=1.0
FUSION_WINDOW_MS=400
FALL_COOLDOWN_SECONDS=30
# edge timing; defaults are fine
POLL_SECONDS=1
HEARTBEAT_SECONDS=5
OFFLINE_BACKOFF_SECONDS=5
HTTP_TIMEOUT_SECONDS=1
UNLOCK_ACK_TIMEOUT_SECONDS=2                       # U sent, no ACK,U from the latch -> unlock_failed
# edge speech-to-text (whisper.cpp apk on QNX); empty WHISPER_MODEL = off
WHISPER_MODEL=                                     # e.g. /data/home/qnxuser/fh-models/ggml-base.en.bin
WHISPER_BIN=whisper-cli                            # fallback when the server is unavailable
WHISPER_SERVER_BIN=whisper-server                  # empty = whisper-cli only
WHISPER_PORT=8090                                  # whisper-server, bound to 127.0.0.1
WHISPER_THREADS=3                                  # 3 of the Pi 5's 4 cores; 4 stalled decoding
WHISPER_PRIORITY=8                                 # QNX priority, below the reader's 10
WHISPER_TIMEOUT_SECONDS=10
AUDIO_FETCH_TIMEOUT_SECONDS=5
